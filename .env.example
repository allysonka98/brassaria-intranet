# Copie para .env e ajuste se quiser outras credenciais.
# A aplicação e o docker-compose leem as mesmas variáveis.

# --- MySQL (padrão, igual ao docker-compose.yml) ---
DB_URL=jdbc:mysql://localhost:3306/brassaria_intranet?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
DB_USERNAME=brassaria
DB_PASSWORD=brassaria123
DB_ROOT_PASSWORD=root

